# huginn-proxy config for the login stack.
# Rendered to /config/huginn.toml by the `proxy-config` compose service, which
# replaces __PROXY_SHARED_SECRET__ with $PROXY_SHARED_SECRET from .env.

preserve_host = true

[listen]
addrs = ["0.0.0.0:7000"]

[[backends]]
address = "login-app:8000"
http_version = "http11"
health_check = { type = "http", path = "/healthz", expected_status = 200, interval_secs = 5, timeout_secs = 2 }

[[domains]]
cert_path = "/config/certs/server.crt"
key_path = "/config/certs/server.key"

[domains.headers.response]
remove = ["Server"]

[[domains.routes]]
prefix = "/"
backend = "login-app:8000"
fingerprinting = true

[headers.request]
# Proves to the Abuse Detection API that fingerprint headers were set by this proxy.
# `add` overwrites any client-supplied value, so clients cannot forge it.
add = [
    { name = "X-Huginn-Proxy-Secret", value = "__PROXY_SHARED_SECRET__" },
]

[tls]
alpn = ["h2", "http/1.1"]

[tls.options]
versions = ["1.2", "1.3"]

[fingerprint]
tls_enabled = true
http_enabled = true
# TCP SYN fingerprinting needs the eBPF image and Linux capabilities.
tcp_enabled = false

[logging]
level = "info"

[telemetry]
metrics_port = 9090
health_format = "json"

[security.ip_filter]
mode = "disabled"

[security.headers]
custom = [
    { name = "X-Frame-Options", value = "DENY" },
    { name = "X-Content-Type-Options", value = "nosniff" },
    { name = "Referrer-Policy", value = "strict-origin-when-cross-origin" },
]

[security.headers.hsts]
# Off for local dev so browsers don't pin https://localhost.
enabled = false

[security.headers.csp]
enabled = true
policy = "default-src 'self'; style-src 'self' 'unsafe-inline'; form-action 'self'; frame-ancestors 'none'"

[security.rate_limit]
enabled = false
